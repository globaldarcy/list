---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Audio Demo">
    <main>
        <section class="v-container">
            <!-- 在页面中调用 ResponsiveVoice.speak() 方法 -->
            <button id="play">Speak</button>
        </section>
    </main>
</Layout>

<style lang="scss"></style>

<!-- 引入 ResponsiveVoice.js 库 -->
<script is:inline src="https://code.responsivevoice.org/responsivevoice.js"></script>
<script is:inline>
    document.addEventListener("click", function () {
        responsiveVoice.speak("你可以根据需要调整 text、lang、volume、rate 和 pitch 等参数，以实现不同的语音效果。这种方式适用于基本的文本到语音转换，如果需要更复杂或自定义的语音合成功能，可能需要结合其他的语音合成服务或库来实现。", "Chinese Female");
    });
