---
import Layout from "../layouts/Layout.astro";
---

<Layout title="事件循环">
    <main>
        <input type="text" placeholder="First input" tabindex="2">
        <input type="text" placeholder="Second input" tabindex="1">
        <input type="text" placeholder="Third input" tabindex="3">
        <div tabindex="0">可聚焦的 div</div>
        <button tabindex="-1">不可通过 Tab 键聚焦的按钮</button>
    </main>
</Layout>

<style lang="scss">
    /* styles.css */
    ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .menu-item {
        position: relative;
    }

    .submenu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: #fff;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .menu-item:focus .submenu {
        display: block;
    }

    .menu-item .submenu li {
        padding: 8px 16px;
    }
</style>

<script is:inline>
    // script.js
    document.addEventListener("DOMContentLoaded", function () {
        const menuItems = document.querySelectorAll(".menu-item");

        menuItems.forEach((item) => {
            item.addEventListener("focus", () => {
                item.querySelector(".submenu").style.display = "block";
            });

            item.addEventListener("blur", () => {
                // item.querySelector(".submenu").style.display = "none";
            });

            // Handle keyboard navigation within the submenu
            item.querySelectorAll(".submenu li").forEach((subItem) => {
                subItem.addEventListener("blur", (e) => {
                    // If the focus is lost from the last submenu item, hide the submenu
                    if (!item.contains(e.relatedTarget)) {
                        // item.querySelector(".submenu").style.display = "none";
                    }
                });
            });
        });
    });
</script>
