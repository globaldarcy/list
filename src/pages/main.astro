<style lang="scss">
    @function vw($px, $design-width: 1920) {
        @return calc($px / $design-width) * 100vw;
    }
    // 文字溢出隐藏显示...
    @mixin text-ellipsis($line: 1) {
        @if $line==1 {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        } @else {
            overflow: hidden;
            text-overflow: ellipsis;
            word-break: break-all;
            display: -webkit-box;
            -webkit-line-clamp: $line;
            -webkit-box-orient: vertical;
        }
    }

    @mixin disabled($grey: false) {
        pointer-events: none;
        user-select: none;
        @if ($grey == true) {
            filter: grayscale(1);
        }
    }


    @mixin visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }
    @mixin border-radius($param: vw(10)) {
        overflow: hidden;
        border-radius: $param;
        transform: rotate(0deg);
    }

    #container {
        margin: 0 auto;
        width: 100%;
        // width: 900px;
        padding: 80px 0 150px;
        @media screen and (max-width: 750px) {
            width: 100%;
        }
    }
    .grid {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        row-gap: 9px;
        justify-content: space-between;
    }

    .grid-item {
        width: vw(300);
        overflow: hidden;
        @media screen and (max-width: 750px) {
            width: vw(375, 750);
        }
    }

    .grid-item img {
        width: 100%;
        display: block;
        background-color: #f5f8fa;
        @include border-radius;
    }
</style>

