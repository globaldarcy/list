    //     if ([90, -90].includes(window.screen.orientation.angle)) {
    //         console.log("横屏", window.screen.orientation);
    //     }
    // })

    // 方法二：使用 window.matchMedia
    function checkOrientation() {
        if (window.matchMedia("(orientation: portrait)").matches) {
            console.log("竖屏");
        } else if (window.matchMedia("(orientation: landscape)").matches) {
            console.log("横屏");
        }
    }

    // 监听屏幕方向变化事件
    // window.matchMedia("(orientation: portrait)").addEventListener("change", checkOrientation);
    // window.matchMedia("(orientation: landscape)").addEventListener("change", checkOrientation);

    // 初始调用
    // checkOrientation();

    window.matchMedia("(orientation: portrait)").addEventListener("change", function () {
        console.log(this);
        if (this.matches) {
            console.log("竖屏");
        }
    });
</script>
