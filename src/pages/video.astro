<style lang="scss">
    @function vw($px) {
        @return calc($px/1920) * 100vw;
    }

    @function vwm($px) {
        @return calc($px/750) * 100vw;
    }
    @mixin mob {
        @media screen and (max-width: 779px), screen and (max-aspect-ratio: 1/1) and (max-width: 1200px) {
            @content;
        }
    }
    @font-face {
        font-family: "Baskerville";
        src:
            url("../fonts/Baskerville.woff2") format("woff2"),
            url("../fonts/Baskerville.woff") format("woff"),
            url("../fonts/Baskerville.ttf") format("truetype");
        font-style: normal;
        font-weight: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "FuturaStd-Book";
        src:
            url("../fonts/FuturaStd-Book.woff2") format("woff2"),
            url("../fonts/FuturaStd-Book.woff") format("woff"),
            url("../fonts/FuturaStd-Book.ttf") format("truetype");
        font-style: normal;
        font-weight: normal;
        font-display: swap;
    }
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    .text-center {
        text-align: center;
    }
    .text-right {
        text-align: right;
    }
    .text-left {
        text-align: left;
    }
    .container {
        position: relative;
        height: 44vw;
        overflow: hidden;
        font-weight: 400;
        margin: 0;
        -webkit-font-smoothing: antialiased;
        font-family: Baskerville, sans-serif;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: 3px;

        @include mob {
            height: 90vh;
        }
    }
    .media {
        position: relative;
        width: 100%;
        height: 100%;
        video {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    .content {
        z-index: 3;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }
    .summary {
        width: vw(800);
        color: #fff;
        @include mob {
            width: vwm(690);
        }
        h1 {
            margin-bottom: vw(24);
            text-transform: uppercase;
            font-size: vw(34);
            letter-spacing: 2px;
            @include mob {
                margin-bottom: vwm(20);
                font-size: vwm(52);
            }
        }
        p {
            font-size: vw(14);
            line-height: vw(24);
            letter-spacing: 1px;
            text-rendering: optimizeLegibility;
            font-family: FuturaStd-Book;
            @include mob {
                font-size: vwm(24);
                line-height: vwm(48);
            }
        }
        .link-primary {
            margin-top: vw(30);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: vw(48);
            min-width: vw(220);
            max-width: vw(500);
            padding: 0 vw(20);
            color: #fff;
            border: solid 1px #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 900;
            line-height: 1.85;
            letter-spacing: 2px;
            @include mob {
                height: vwm(96);
                padding: 0 vwm(40);
                margin-top: vwm(40);
                max-width: vwm(600);
                min-width: vwm(424);
            }
            &:hover {
                border-width: 2px;
            }
            & + .link-primary {
                margin-left: vw(30);
                @include mob {
                    margin-left: 0;
                }
            }
        }
        &.summary-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            @include mob {
                top: 40%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
        }
        &.summary-left {
            position: absolute;
            top: 50%;
            left: vw(220);
            transform: translateY(-50%);
            @include mob {
                top: 40%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
        }
        &.summary-right {
            position: absolute;
            top: 50%;
            right: vw(220);
            transform: translateY(-50%);
            @include mob {
                top: 40%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
        }
        &.summary-btm {
            position: absolute;
            top: auto;
            bottom: vw(100);
            transform: none;
            @include mob {
                bottom: vwm(150);
                left: 50%;
                transform: translateX(-50%);
            }
        }
    }
    .video-btn-group {
        z-index: 3;
        position: absolute;
        bottom: vw(30);
        right: vw(100);
        display: flex;
        @include mob {
            bottom: vwm(30);
            right: vwm(30);
        }
    }
    .video-cc,
    .video-btn {
        overflow: hidden;
        display: inline-flex;
        min-width: 40px;
        height: 40px;
        background-color: rgba(0, 0, 0, 0.5);
        font-family: FuturaStd-Book;

        & + a {
            margin-left: vw(15);
            @include mob {
                margin-left: vwm(30);
            }
        }
    }
    .video-cc {
        padding: 0 vw(10);
        justify-content: center;
        align-items: center;
        color: #fff;
        text-decoration: none;
        font-size: vw(14);
        line-height: 1;
        @include mob {
            padding: 0 vwm(20);
            font-size: vwm(28);
        }
    }
    .play-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 40px;
        height: 40px;
    }

    .play-button::after {
        content: "";
        display: inline-block;
        border-style: solid;
        border-width: 7px 0 7px 12px;
        border-color: transparent transparent transparent #ecedef;
    }
    .pause-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 40px;
        height: 40px;
        position: relative;
    }

    .pause-button::before,
    .pause-button::after {
        content: "";
        position: absolute;
        background-color: #ecedef;
    }

    .pause-button::before {
        width: 3px;
        height: 16px;
        left: 15px;
    }

    .pause-button::after {
        width: 3px;
        height: 16px;
        right: 15px;
    }
</style>

<script is:inline>
    const videos = document.querySelectorAll(".load-video");
    const btns = document.querySelectorAll(".video-btn");
    const ccBtns = document.querySelectorAll(".video-cc");
    btns.forEach((item, index) => {
        const video = videos[index];
        item.addEventListener("click", function () {
            const that = this;
            togglePlayPause(video, that);
        });
    });
    ccBtns.forEach((item, index) => {
        const video = videos[index];
        const track = video.textTracks[0];
        item.addEventListener("click", function () {
            if (track.mode === "showing") {
                track.mode = "hidden";
                item.textContent = "CC(On)";
            } else {
                track.mode = "showing";
                item.textContent = "CC(Off)";
            }
        });
    });

    function togglePlayPause(video, that) {
        if (video.paused) {
            video.play();
            that.querySelector(".pause-button").style.display = "flex";
            that.querySelector(".play-button").style.display = "none";
        } else {
            video.pause();
            that.querySelector(".pause-button").style.display = "none";
            that.querySelector(".play-button").style.display = "flex";
        }
    }
</script>
