---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Video Demo">
    <main>
        <section id="container">
            <div class="media">
                <video id="myVideo" autoplay loop muted playsinline="true" webkit-playsinline="true" x-webkit-airplay="true" x5-video-player-type="h5" x5-video-player-fullscreen="true" class="load-video" poster="../media/flower.jpg">
                    <source src="../media/flower.webm" type="video/webm" />
                    <source src="../media/video.mp4" type="video/mp4" />
                </video>
            </div>
            <summary>
                <h1>THE LANGHAM HOTELS & RESORTS</h1>
                <p>The Brilliant by Langham loyalty programme gives you more for less. Boost your benefits by rising up through membership tiers, turning travel into treasured memories.</p>
            </summary>
            <a href="javascript:void(0)'" id="btn">
                <span class="pause-button"></span>
                <span class="play-button" style="display: none;"></span>
            </a>
        </section>
    </main>
</Layout>

<style>
    @font-face {
        font-family: "Baskerville";
        src:
            url("../fonts/Baskerville.woff2") format("woff2"),
            url("../fonts/Baskerville.woff") format("woff"),
            url("../fonts/Baskerville.ttf") format("truetype");
        font-style: normal;
        font-weight: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "FuturaStd-Book";
        src:
            url("../fonts/FuturaStd-Book.woff2") format("woff2"),
            url("../fonts/FuturaStd-Book.woff") format("woff"),
            url("../fonts/FuturaStd-Book.ttf") format("truetype");
        font-style: normal;
        font-weight: normal;
        font-display: swap;
    }
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    #container {
        position: relative;
        height: 80%;
        max-height: 800px;
        overflow: hidden;
        font-weight: 400;
        margin: 0;
        -webkit-font-smoothing: antialiased;
        font-family: Baskerville, sans-serif;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: 3px;
    }
    video {
        width: 100%;
        display: block;
        object-fit: cover;
    }
    summary {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        max-width: ;
        padding: 0 15%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        background-color: rgba(0, 0, 0, 0.5);
        text-align: center;
    }
    h1 {
        max-width: 830px;
        margin-bottom: 20px;
        text-transform: uppercase;
        font-size: 40px;
    }
    p {
        max-width: 800px;
        font-size: 14px;
        line-height: 24px;
        letter-spacing: 1px;
        text-rendering: optimizeLegibility;
        font-family: FuturaStd-Book;
    }
    a {
        overflow: hidden;
        display: block;
        z-index: 3;
        position: absolute;
        bottom: 100px;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 40px;
        background-color: rgba(0, 0, 0, 0.5);
        font-family: FuturaStd-Book;
    }
    .play-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 40px;
        height: 40px;
    }

    .play-button::after {
        content: "";
        display: inline-block;
        border-style: solid;
        border-width: 7px 0 7px 12px;
        border-color: transparent transparent transparent #ECEDEF;
    }
    .pause-button {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 40px;
        height: 40px;
        position: relative;
    }

    .pause-button::before,
    .pause-button::after {
        content: "";
        position: absolute;
        background-color: #ECEDEF;
    }

    .pause-button::before {
        width: 3px;
        height: 16px;
        left: 15px;
    }

    .pause-button::after {
        width: 3px;
        height: 16px;
        right: 15px;
    }
</style>

<script is:inline>
    var video = document.getElementById("myVideo");
    var btn = document.getElementById("btn");

    btn.addEventListener("click", togglePlayPause);

    function togglePlayPause() {
        if (video.paused) {
            video.play();
            this.querySelector(".pause-button").style.display = "flex";
            this.querySelector(".play-button").style.display = "none";
        } else {
            video.pause();
            this.querySelector(".pause-button").style.display = "none";
            this.querySelector(".play-button").style.display = "flex";
        }
    }
</script>
